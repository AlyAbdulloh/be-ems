// ============================================================
// Event Management System - Prisma Schema
// Stack: NestJS + Prisma + PostgreSQL
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@internal/prisma/ems"
}

datasource db {
  provider = "postgresql"
  url      = env("EMS_DATABASE_URL")
}

enum RoleName {
  ADMIN
}

enum OrganizerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum VenueType {
  OFFLINE
  ONLINE
  HYBRID
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  EXPIRED
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum NotificationType {
  EVENT_UPDATE
  EVENT_REMINDER
  PAYMENT_CONFIRMATION
  TICKET_ISSUED
  GENERAL
}

model Role {
  id    String     @id @default(uuid()) @db.Uuid
  name  RoleName   @unique
  users UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String   @map("role_id") @db.Uuid
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(100)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  phone        String?   @db.VarChar(20)
  avatarUrl    String?   @map("avatar_url") @db.VarChar(500)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  roles         UserRole[]
  organizer     Organizer?
  registrations EventRegistration[]
  orders        Order[]
  reviews       Review[]
  notifications Notification[]

  @@index([email])
  @@map("users")
}

model Organizer {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @unique @map("user_id") @db.Uuid
  user             User            @relation(fields: [userId], references: [id])
  organizationName String          @map("organization_name") @db.VarChar(150)
  description      String?         @db.Text
  status           OrganizerStatus @default(PENDING)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  events Event[]

  @@index([status])
  @@map("organizers")
}

model Venue {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @db.VarChar(150)
  address    String?   @db.Text
  city       String?   @db.VarChar(100)
  capacity   Int?
  latitude   Float?
  longitude  Float?
  type       VenueType @default(OFFLINE)
  meetingUrl String?   @map("meeting_url") @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  events Event[]

  @@index([city])
  @@map("venues")
}

model EventCategory {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(100)

  events Event[]

  @@map("event_categories")
}

model Event {
  id            String         @id @default(uuid()) @db.Uuid
  organizerId   String         @map("organizer_id") @db.Uuid
  organizer     Organizer      @relation(fields: [organizerId], references: [id])
  venueId       String?        @map("venue_id") @db.Uuid
  venue         Venue?         @relation(fields: [venueId], references: [id])
  categoryId    String?        @map("category_id") @db.Uuid
  category      EventCategory? @relation(fields: [categoryId], references: [id])
  title         String         @db.VarChar(200)
  slug          String         @unique @db.VarChar(220)
  description   String?        @db.Text
  bannerImage   String?        @map("banner_image") @db.VarChar(500)
  startDatetime DateTime       @map("start_datetime")
  endDatetime   DateTime       @map("end_datetime")
  status        EventStatus    @default(DRAFT)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")

  sessions      EventSession[]
  ticketTypes   TicketType[]
  promoCodes    PromoCode[]
  registrations EventRegistration[]
  orders        Order[]
  reviews       Review[]

  @@index([organizerId])
  @@index([slug])
  @@index([status])
  @@index([startDatetime])
  @@map("events")
}

model Speaker {
  id      String  @id @default(uuid()) @db.Uuid
  name    String  @db.VarChar(100)
  bio     String? @db.Text
  photo   String? @db.VarChar(500)
  company String? @db.VarChar(100)

  sessions EventSession[]

  @@map("speakers")
}

model EventSession {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  speakerId   String?  @map("speaker_id") @db.Uuid
  speaker     Speaker? @relation(fields: [speakerId], references: [id])
  title       String   @db.VarChar(200)
  description String?  @db.Text
  startTime   DateTime @map("start_time")
  endTime     DateTime @map("end_time")
  roomOrTrack String?  @map("room_or_track") @db.VarChar(100)

  @@index([eventId])
  @@index([speakerId])
  @@map("event_sessions")
}

model EventRegistration {
  id        String             @id @default(uuid()) @db.Uuid
  eventId   String             @map("event_id") @db.Uuid
  event     Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String             @map("user_id") @db.Uuid
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    RegistrationStatus @default(PENDING)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@map("event_registrations")
}

model TicketType {
  id            String    @id @default(uuid()) @db.Uuid
  eventId       String    @map("event_id") @db.Uuid
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name          String    @db.VarChar(100)
  price         Decimal   @db.Decimal(12, 2)
  quota         Int
  soldCount     Int       @default(0) @map("sold_count")
  saleStartDate DateTime? @map("sale_start_date")
  saleEndDate   DateTime? @map("sale_end_date")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  orderItems OrderItem[]

  @@index([eventId])
  @@map("ticket_types")
}

model PromoCode {
  id            String       @id @default(uuid()) @db.Uuid
  eventId       String       @map("event_id") @db.Uuid
  event         Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  code          String       @db.VarChar(50)
  discountType  DiscountType @map("discount_type")
  discountValue Decimal      @map("discount_value") @db.Decimal(12, 2)
  maxUsage      Int?         @map("max_usage")
  usedCount     Int          @default(0) @map("used_count")
  validFrom     DateTime?    @map("valid_from")
  validUntil    DateTime?    @map("valid_until")

  orders Order[]

  @@unique([eventId, code])
  @@index([eventId])
  @@map("promo_codes")
}

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  user        User        @relation(fields: [userId], references: [id])
  eventId     String      @map("event_id") @db.Uuid
  event       Event       @relation(fields: [eventId], references: [id])
  promoCodeId String?     @map("promo_code_id") @db.Uuid
  promoCode   PromoCode?  @relation(fields: [promoCodeId], references: [id])
  totalAmount Decimal     @map("total_amount") @db.Decimal(12, 2)
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  items    OrderItem[]
  payments Payment[]

  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id           String     @id @default(uuid()) @db.Uuid
  orderId      String     @map("order_id") @db.Uuid
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTypeId String     @map("ticket_type_id") @db.Uuid
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  quantity     Int
  subtotal     Decimal    @db.Decimal(12, 2)

  tickets Ticket[]

  @@index([orderId])
  @@index([ticketTypeId])
  @@map("order_items")
}

model Ticket {
  id            String       @id @default(uuid()) @db.Uuid
  orderItemId   String       @map("order_item_id") @db.Uuid
  orderItem     OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  attendeeName  String       @map("attendee_name") @db.VarChar(100)
  attendeeEmail String       @map("attendee_email") @db.VarChar(255)
  qrCode        String       @unique @map("qr_code") @db.VarChar(255)
  status        TicketStatus @default(VALID)
  checkedInAt   DateTime?    @map("checked_in_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([qrCode])
  @@index([status])
  @@map("tickets")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod     String        @map("payment_method") @db.VarChar(50)
  paymentGatewayRef String?       @map("payment_gateway_ref") @db.VarChar(255)
  amount            Decimal       @db.Decimal(12, 2)
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?     @map("paid_at")
  createdAt         DateTime      @default(now()) @map("created_at")

  @@index([orderId])
  @@index([paymentGatewayRef])
  @@map("payments")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([eventId, userId])
  @@index([userId])
  @@map("reviews")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  message   String           @db.Text
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@map("notifications")
}
